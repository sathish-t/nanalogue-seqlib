#!/usr/bin/env bash
# Orb setup for rust-htslib (HTSlib bindings for Rust).
#
# Installs the toolchain and build prerequisites a fresh orb needs to build,
# test, lint, and format this crate, then downloads its Rust dependencies.
# Designed to be idempotent: a warm run skips every install and only checks
# that the dependency cache is in place.
#
# Native libraries are copied into vendor/. Consumer builds need Zig, CMake,
# Make and Perl, but neither native development packages nor libclang.
set -euo pipefail

step() { printf '\n\033[1m[%s] %s\033[0m\n' "$(date +%H:%M:%S)" "$*"; }
finish_step() { printf '\033[1m[%s] completed in %ss\033[0m\n' "$(date +%H:%M:%S)" "$((SECONDS - $1))"; }

# This script runs as a bare (non-login, non-interactive) shell, so it does
# not source ~/.bash_profile or ~/.bashrc. Source cargo's env up front if a
# previous run already installed rustup, so command -v cargo works below and
# we don't re-run the installer on warm runs. No-op before rustup exists.
# shellcheck disable=SC1091
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# --- Upstream curl/OpenSSL and verified Zig build tools -----------------
need_apt=()
for pkg in cmake make minisign perl; do
    if ! dpkg -s "$pkg" >/dev/null 2>&1; then
        need_apt+=("$pkg")
    fi
done
if [ "${#need_apt[@]}" -gt 0 ]; then
    step "apt-get install: ${need_apt[*]}"
    started=$SECONDS
    sudo apt-get update -y
    sudo apt-get install -y --no-install-recommends "${need_apt[@]}"
    finish_step "$started"
else
    step "native build tools already installed"
fi

step "ensuring pinned Zig 0.15.2 toolchain"
started=$SECONDS
bash native/install-zig.sh
finish_step "$started"
export PATH="$HOME/.local/bin:$PATH"
zig_marker="# rust-htslib orb: Zig on PATH"
if ! grep -Fqx "$zig_marker" "$HOME/.bash_profile" 2>/dev/null; then
    printf '\n%s\nexport PATH="$HOME/.local/bin:$PATH"\n' "$zig_marker" >> "$HOME/.bash_profile"
fi

# --- Rust toolchain (stable + rustfmt + clippy) -----------------------------
# rustup installs into ~/.cargo and adds `source ~/.cargo/env` to ~/.profile
# and ~/.bashrc. But this orb's ~/.bash_profile exists and does NOT source
# either of those, and bash login shells read ~/.bash_profile exclusively.
# So we also wire cargo into ~/.bash_profile ourselves (see below) to ensure
# non-interactive login shells (Amp, supervised services) get cargo on PATH.
if ! command -v cargo >/dev/null 2>&1; then
    step "installing rustup + stable toolchain (minimal profile)"
    started=$SECONDS
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain stable
    finish_step "$started"
    # The installer cannot update this running script's environment.
    # shellcheck disable=SC1091
    source "$HOME/.cargo/env"
else
    step "rust toolchain already present: $(cargo --version)"
fi

missing_components=()
installed_components="$(rustup component list --installed)"
grep -q '^rustfmt-' <<<"$installed_components" || missing_components+=(rustfmt)
grep -q '^clippy-' <<<"$installed_components" || missing_components+=(clippy)
if [ "${#missing_components[@]}" -gt 0 ]; then
    step "installing Rust components: ${missing_components[*]}"
    started=$SECONDS
    rustup component add "${missing_components[@]}"
    finish_step "$started"
else
    step "rustfmt + clippy already installed"
fi

# Make cargo reachable from non-interactive login shells. Idempotent and
# guarded by a marker so repeated setup runs do not duplicate the block.
cargo_env="$HOME/.cargo/env"
profile_marker="# rust-htslib orb: cargo on PATH for login shells"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    step "wiring cargo into ~/.bash_profile"
    cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [ -f "$cargo_env" ]; then
    . "$cargo_env"
fi
EOF
fi

# --- Rust dependencies ------------------------------------------------------
# Do not compile here. This crate's build script compiles vendored OpenSSL,
# curl, compression libraries, and HTSlib. Building default and all-feature
# variants creates separate native outputs and can exceed Amp's setup limit.
# Fetching still makes the comparatively small Rust dependency graph available
# in the snapshot; agents compile only the feature set their task needs.
step "cargo fetch — warm dependency cache"
started=$SECONDS
cargo fetch
finish_step "$started"

step "setup complete"
